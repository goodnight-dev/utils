{
  "name": "@goodnight-dev/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the @goodnight-dev utility suite.",
  "license": "MIT",
  "author": "Ian Goodnight",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "new": "plop",
    "build": "pnpm -r build",
    "docs:build": "typedoc",
    "docs:watch": "typedoc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "publint": "pnpm -r exec publint",
    "attw": "pnpm -r exec attw --pack --profile esm-only .",
    "check:exports": "pnpm run publint && pnpm run attw",
    "check": "pnpm run format && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run check:exports",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "lefthook": "^2.1.10",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10"
  }
}
